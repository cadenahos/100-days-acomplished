# VITE_API_URL is intentionally gone. The frontend calls the relative path
# /api, which Vite proxies in dev and nginx proxies in production. Point dev
# at a different backend with DEV_BACKEND_URL instead (see vite.config.js).
VITE_GOOGLE_CLIENT_ID=your-real-google-client-id-here.apps.googleusercontent.com

# Set to 'true' to keep verbose [api] logging in a production build.
# VITE_DEBUG_API=false
